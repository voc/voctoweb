!!! 5
%html{lang: 'en'}
  %head
    = render 'frontend/shared/header'
    %title
      - if content_for?(:title)
        = yield :title
      - else
        = @event.try(:title) || @conference.try(:title)
      = t('custom.title')

    = render partial: 'frontend/shared/noscript'

    = yield :head

    - unless @conference.nil? ||  @conference.custom_css.nil?
      %style
        = @conference.try(:custom_css).html_safe

  %body{:class => content_for(:body_class), data: {mejs_controls_svg: asset_path('mejs-controls.svg'), mejs_skip_back_svg: asset_path('mejs-skip-back.svg'), mejs_jump_forward_svg: asset_path('mejs-jump-forward.svg')}}
    = render partial: 'frontend/shared/navbar'

    = yield

    = render 'frontend/shared/footer'
